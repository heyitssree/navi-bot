[Unit]
Description=Navi V2 — Trivandrum Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=navi
WorkingDirectory=/home/navi/navi-bot
EnvironmentFile=/home/navi/navi-bot/.env
ExecStartPre=/bin/bash /home/navi/navi-bot/scripts/clean_pycache.sh
ExecStart=/home/navi/navi-bot/.venv/bin/python -m navi
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/navi/navi-bot/logs/bot.log
StandardError=append:/home/navi/navi-bot/logs/bot.log

[Install]
WantedBy=multi-user.target
