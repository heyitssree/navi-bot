# Secrets — never commit
.env
**/.env

# DuckDB database (environment-specific, auto-created on startup)
data/*.db
data/*.wal

# Activity backend SQLite DB
activity/backend/data/

# Log files
logs/*.log

# Old JSON cache (migrated to DuckDB)
response_cache.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Node / frontend
activity/frontend/node_modules/
activity/frontend/dist/

# NOTE: .env.example IS tracked (it contains no real keys)
