# Secrets — never commit
.env
**/.env

# SQLite database (environment-specific, auto-created on startup)
data/*.db
data/*.wal
data/*.db-shm
data/*.db-wal

# Log files
logs/*.log

# Old JSON cache (migrated to DuckDB)
response_cache.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# NOTE: .env.example IS tracked (it contains no real keys)

# v2 dev tooling
.env.*
!.env.example
data/dev/
data/*.db
*.db
data/local_media/
data/backups/
.pytest_cache/
.ruff_cache/
