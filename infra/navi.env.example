# Copy to infra/navi.env (git-ignored) and fill in. Real environment variables (NAVI_*) override this file.
# Nothing account-specific is kept in code or cdk.json.

NAVI_ENV_NAME=prod
NAVI_ACCOUNT=<12-digit AWS account id>      # `aws sts get-caller-identity --query Account --output text`
NAVI_REGION=<region>                        # a region your account's policies allow; the CLI's region is ignored
NAVI_AVAILABILITY_ZONE=<region>a            # one explicit AZ keeps synth offline
NAVI_ALERT_EMAIL=<you@example.com>          # heartbeat alarm + budget alerts (confirm the SNS email after deploy)
NAVI_MONTHLY_BUDGET_USD=15

# Bedrock model the bot may call. A plain on-demand id (google.gemma-3-12b-it) gets one IAM statement; an id with a geography
# prefix (global., apac., ...) is treated as an inference profile and gets the three-statement policy.
NAVI_BEDROCK_MODEL_ID=<model id>
NAVI_BEDROCK_MODEL_ARN_PATTERN=<foundation model id, usually the same as above>

# Optional overrides (defaults in cdk.json): NAVI_INSTANCE_TYPE, NAVI_USE_SPOT, NAVI_ROOT_VOLUME_GIB
