# =============================================================================
# Navi (Navi) - environment variables
# Copy to .env and fill in. Lines starting with # are comments.
# Never commit the real .env file.
# =============================================================================

# ---- REQUIRED ---------------------------------------------------------------

# Discord bot token.
# Where: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-discord-bot-token

# Your Discord server (guild) ID. Used to restrict the partner/internal API to your server.
# Where: Discord -> User Settings -> Advanced -> enable Developer Mode, then
#        right-click your server icon -> Copy Server ID
GUILD_ID=your-server-id

# Your own Discord user ID (unlocks owner-only commands such as /health).
# Where: with Developer Mode on, right-click your name -> Copy User ID
OWNER_ID=your-discord-user-id

# Google Gemini API key (free tier is tried first).
# Where: https://aistudio.google.com/app/apikey -> Create API key
GEMINI_API_KEY_FREE=your-free-gemini-api-key

# ---- OPTIONAL ---------------------------------------------------------------

# Second Gemini key used as a fallback when the free key is rate limited.
# Where: same page as above (use a key from a billing-enabled project). Leave as-is to skip.
GEMINI_API_KEY_PAID=your-paid-gemini-api-key

# true = prefer the free key and be frugal with API calls.
FREE_TIER_MODE=true

# Channel NAMES (not IDs) the bot uses. Defaults shown.
GENERAL_CHANNEL=general
MOD_CHANNEL_NAME=mod-log

# Gemini model used for all calls. Default: gemini-3.5-flash-lite.
# At startup the bot checks the key can use it and falls back to gemini-3.8-flash if not.
# LLM_MODEL=gemini-3.5-flash-lite

# Where the SQLite database lives. Default: data/navi.db inside this repo.
# Point it outside the repo so a git pull can never touch it.
# v2 note: a pre-v2 file is refused at startup. Convert it first:
#   python -m tools.migrate_v2 --src <old.db> --dst data/v2/navi.db --privacy data/v2/privacy.db
# DB_PATH=/home/youruser/navi.db

# ---- HTTP API (only needed if another bot/service sends Boli points to Navi) -
# The API listens on API_SERVER_PORT. Open that port in your firewall if the
# caller is on another machine.
# API_SERVER_PORT=8080

# Bearer token partner bots must send to POST /score. Make up a long random string:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PARTNER_BOT_API_KEY=change-me-to-a-random-secret

# Shared secret for POST /internal/boli/award (used by the Bamboozled Activity
# backend). Must be identical to BOT_INTERNAL_SECRET in the bamboozled-bot .env.
# Generate with the same command as above. Leave empty to disable the endpoint.
BOT_INTERNAL_SECRET=
